# Copy to .env for local development. Never commit .env.
# In production these are Fly secrets: fly secrets set NAME=value

# Shared access token the app sends as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MAGICSIM_TOKEN=

# Required for Claude-controlled seats and the model list
ANTHROPIC_API_KEY=

# Per-seat, per-game token budget before a seat falls back to Forge AI
AI_TOKEN_BUDGET=400000

# Decision-model scorer (spec §6.5). Off by default.
DECISION_SCORER=off
SUBQ_API_KEY=
OPENAI_API_KEY=

# Server port (Fly sets PORT automatically)
PORT=8080
